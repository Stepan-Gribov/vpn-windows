+// readPacketStream restores packet boundaries over NetworkExtension's socketpair.
+// Frames use the Darwin utun header followed by one IPv4 or IPv6 packet.
+func (t *DarwinTun) readPacketStream() (byte, *stack.PacketBuffer, error) {
+	var header [utunHeaderSize]byte
+	if _, err := io.ReadFull(t.tunFile, header[:]); err != nil {
+		return 0, nil, err
+	}
+
+	var packet []byte
+	var version byte
+	switch header[3] {
+	case unix.AF_INET:
+		version = 4
+		var ipv4Header [20]byte
+		if _, err := io.ReadFull(t.tunFile, ipv4Header[:]); err != nil {
+			return 0, nil, err
+		}
+		totalLength := int(binary.BigEndian.Uint16(ipv4Header[2:4]))
+		if totalLength < len(ipv4Header) {
+			return 0, nil, errors.New("invalid IPv4 total length")
+		}
+		packet = make([]byte, totalLength)
+		copy(packet, ipv4Header[:])
+		if _, err := io.ReadFull(t.tunFile, packet[len(ipv4Header):]); err != nil {
+			return 0, nil, err
+		}
+	case unix.AF_INET6:
+		version = 6
+		var ipv6Header [40]byte
+		if _, err := io.ReadFull(t.tunFile, ipv6Header[:]); err != nil {
+			return 0, nil, err
+		}
+		payloadLength := int(binary.BigEndian.Uint16(ipv6Header[4:6]))
+		packet = make([]byte, len(ipv6Header)+payloadLength)
+		copy(packet, ipv6Header[:])
+		if _, err := io.ReadFull(t.tunFile, packet[len(ipv6Header):]); err != nil {
+			return 0, nil, err
+		}
+	default:
+		return 0, nil, errors.New("unknown AF in stream packet header")
+	}
+
+	return version, stack.NewPacketBuffer(stack.PacketBufferOptions{
+		Payload:           buffer.MakeWithData(packet),
+		IsForwardedPacket: true,
+	}), nil
+}
